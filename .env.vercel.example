DJANGO_SETTINGS_MODULE=config.settings.vercel
DJANGO_SECRET_KEY=replace-with-generated-secret
DJANGO_ALLOWED_HOSTS=dynamic-forms-platform-tan.vercel.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://dynamic-forms-platform-tan.vercel.app
POSTGRES_DB=dynamic_forms
POSTGRES_USER=replace-with-neon-role
POSTGRES_PASSWORD=replace-with-neon-password
POSTGRES_HOST=replace-with-neon-pooler-host
POSTGRES_DIRECT_HOST=replace-with-neon-direct-host
POSTGRES_PORT=5432
POSTGRES_CONNECT_TIMEOUT_SECONDS=10
DJANGO_CACHE_BACKEND=postgresql
CELERY_BROKER_URL=vercel://
CRON_SECRET=replace-with-generated-cron-secret
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=your-sender@gmail.com
DJANGO_EMAIL_HOST_PASSWORD=replace-with-google-app-password-without-spaces
DJANGO_EMAIL_USE_TLS=true
DJANGO_EMAIL_TIMEOUT=10
DJANGO_DEFAULT_FROM_EMAIL=Dynamic Forms <your-sender@gmail.com>
