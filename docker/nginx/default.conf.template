map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# Participant URLs can contain access/resume secrets: never log arguments or referers.
log_format safe_access '$remote_addr $request_method $uri $status $body_bytes_sent';

server {
    listen 80;
    server_name _;
    server_tokens off;
    # Docker can change web's address when it is recreated during an update.
    resolver 127.0.0.11 valid=5s ipv6=off;
    resolver_timeout 2s;
    access_log /var/log/nginx/access.log safe_access;
    # Nginx error diagnostics can include the full request URI. Application logs
    # and secret-safe access status provide routine failure diagnosis instead.
    error_log /dev/null;
    client_max_body_size 1m;
    client_header_timeout 10s;
    client_body_timeout 10s;
    send_timeout 15s;

    location /static/ {
        alias /srv/static/;
        autoindex off;
        add_header X-Content-Type-Options nosniff always;
    }

    location ~ (^|/)\. {
        return 404;
    }

    location / {
        set $app_upstream web:8000;
        proxy_pass http://$app_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto ${NGINX_PROXY_SCHEME};
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header Forwarded "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
        proxy_send_timeout 15s;
    }
}
