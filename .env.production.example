# Placeholder values only. Replace before deployment; never commit .env.production.
DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_ALLOWED_HOSTS=example.com,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
DJANGO_SECURE_SSL_REDIRECT=true

POSTGRES_DB=dynamic_forms
POSTGRES_USER=dynamic_forms
POSTGRES_PASSWORD=replace-with-a-production-database-password
POSTGRES_CONNECT_TIMEOUT_SECONDS=2
READINESS_DB_QUERY_TIMEOUT_MS=1000
REDIS_CONNECT_TIMEOUT_SECONDS=1
REDIS_SOCKET_TIMEOUT_SECONDS=1

# Default ingress is local. Publish publicly only with an appropriate TLS boundary.
NGINX_BIND_ADDRESS=127.0.0.1
PRODUCTION_HTTP_PORT=8080
NGINX_PROXY_SCHEME=http
# If a trusted TLS edge is the ONLY caller of this loopback ingress, set https.
# Local HTTP smoke: keep http and explicitly set DJANGO_SECURE_SSL_REDIRECT=false.

DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=replace-with-smtp-username
DJANGO_EMAIL_HOST_PASSWORD=replace-with-smtp-password
DJANGO_EMAIL_USE_TLS=true
DJANGO_EMAIL_TIMEOUT=10
DJANGO_DEFAULT_FROM_EMAIL=no-reply@example.com
